# List settings must be JSON arrays.
# MEANING_CHAIN=["gemini:gemini-3.5-flash-lite","groq:openai/gpt-oss-120b","gemini:gemini-3.1-flash-lite"]

ALLOWED_ORIGINS=["http://localhost:3000"]
